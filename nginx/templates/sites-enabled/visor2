upstream ohif_v3 {
  server <pacs-host>:8888;
  keepalive 32;
}

server {
  listen  443 ssl http2;
  server_name  visor-<docker-host>;
  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_session_timeout 5m;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  gzip on;
  gunzip on;
  gzip_proxied no-cache no-store private expired auth;

  location ~  /viewer/(.+)/ {
        set $token  "$args";
        set $id "$1";

        return 301 https://visor-<docker-host>/viewer/?StudyInstanceUIDs=$1&$token;
    }

  # App shell / config / service worker: never cache so new builds propagate.
  location ~* ^/(index\.html|app-config\.js|(service-worker|sw)\.js|manifest\.json)$ {
    proxy_pass          http://ohif_v3;
    proxy_http_version  1.1;
    proxy_set_header    Connection "";
    proxy_set_header    Host $host;
    proxy_hide_header   Cache-Control;
    add_header          Cache-Control "no-store, no-cache, must-revalidate" always;
    expires             -1;
  }

  # Hashed immutable assets: cache aggressively.
  location ~* \.[0-9a-f]+\.(js|css|woff2?|wasm)$ {
    proxy_pass          http://ohif_v3;
    proxy_http_version  1.1;
    proxy_set_header    Connection "";
    proxy_set_header    Host $host;
    add_header          Cache-Control "public, max-age=31536000, immutable" always;
  }

  location / {
        proxy_pass          http://ohif_v3;
        proxy_http_version  1.1;
        proxy_set_header    Connection "";
        proxy_set_header    Host $host;
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
  }
}
